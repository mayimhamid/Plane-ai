# =============================================================================
# Plane AI - environment configuration
# Copy to `.env` (shared) and optionally `.env.development` / `.env.production`
# (environment-specific overrides). Real environment variables win over files.
# Never commit real secrets. All variables use the PLANE_AI_ prefix.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production | test
PLANE_AI_APP_ENV=development
# Defaults: true in development, false otherwise. Must be false in production.
# PLANE_AI_DEBUG=
# Defaults: DEBUG in development/test, INFO in production.
# PLANE_AI_LOG_LEVEL=

# --- API server --------------------------------------------------------------
# 127.0.0.1 keeps the API local-only. Use 0.0.0.0 inside containers.
PLANE_AI_API_HOST=127.0.0.1
# 8100 avoids clashing with Plane's own API (8000).
PLANE_AI_API_PORT=8100

# --- Database (Plane AI's own PostgreSQL, separate from Plane's) -------------
# Option A: full URL (takes precedence over the parts below)
# PLANE_AI_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Option B: individual parts
PLANE_AI_DB_HOST=localhost
# 5433 avoids clashing with a local Plane PostgreSQL on 5432.
PLANE_AI_DB_PORT=5433
PLANE_AI_DB_NAME=plane_ai
PLANE_AI_DB_USER=plane_ai
# Required in production AND by docker compose. Use a long random value.
PLANE_AI_DB_PASSWORD=
# PLANE_AI_DB_POOL_SIZE=5
# PLANE_AI_DB_MAX_OVERFLOW=5
# PLANE_AI_DB_CONNECT_TIMEOUT_SECONDS=5
# Log every SQL statement (noisy).
# PLANE_AI_DB_ECHO=false

# --- Docker compose only ----------------------------------------------------
# Inside containers the API always uses host plane-ai-db:5432; the DB_HOST/DB_PORT
# values above are for running the API directly on your machine.
# Run `alembic upgrade head` when the API container starts.
PLANE_AI_RUN_MIGRATIONS=true
# Host interface the API port is published on (127.0.0.1 = this machine only).
PLANE_AI_API_BIND=127.0.0.1
# PLANE_AI_IMAGE_TAG=latest

# --- Model storage -----------------------------------------------------------
# For the API running directly on your machine. Relative paths resolve from the
# repo root; `models/` is git-ignored. Weights must never be committed.
PLANE_AI_MODEL_STORAGE_PATH=./models
# Docker: where the shared model lives. Default: named volume `plane-ai-models`.
# Set a host path (outside the repo) for a bind mount, e.g. /srv/plane-ai/models
# (must be writable by uid 10001: `sudo chown 10001:10001 /srv/plane-ai/models`).
# PLANE_AI_MODEL_VOLUME=/srv/plane-ai/models

# --- Model download (model-init service) ------------------------------------
# Defaults: Qwen3.5-2B-Q4_K_M.gguf from unsloth/Qwen3.5-2B-GGUF, pinned commit,
# with its known SHA256. Override both together for a different model.
# PLANE_AI_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-2B-GGUF/resolve/f6d5376be1edb4d416d56da11e5397a961aca8ae/Qwen3.5-2B-Q4_K_M.gguf
# PLANE_AI_MODEL_SHA256=aaf42c8b7c3cab2bf3d69c355048d4a0ee9973d48f16c731c0520ee914699223
# Only for gated Hugging Face repos. Secret: keep it in .env only.
# PLANE_AI_HF_TOKEN=
# PLANE_AI_MODEL_DOWNLOAD_RETRIES=5
# Skip checksum verification for a custom URL without a known hash (not recommended).
# PLANE_AI_MODEL_ALLOW_UNVERIFIED=false

# --- LLM runtime -------------------------------------------------------------
# ollama | llama-cpp. Selects the runtime for both the API and docker compose.
PLANE_AI_LLM_RUNTIME=ollama
# Compose starts only services in this profile, so exactly one runtime runs.
# Keep it equal to PLANE_AI_LLM_RUNTIME and never list both.
COMPOSE_PROFILES=${PLANE_AI_LLM_RUNTIME}
# Shared GGUF file name inside the model storage (used by both runtimes).
PLANE_AI_LLM_MODEL_FILE=Qwen3.5-2B-Q4_K_M.gguf
# Name the model is served under (Ollama model name / llama.cpp alias).
PLANE_AI_LLM_MODEL_NAME=qwen3.5-2b
# Runtime host. Docker overrides this with `plane-ai-llm`.
PLANE_AI_LLM_HOST=localhost
# Defaults to http://<LLM_HOST>:11434 (ollama) or :8080 (llama-cpp).
# PLANE_AI_LLM_BASE_URL=
# Context window in tokens (512 - 131072).
PLANE_AI_LLM_CONTEXT_LENGTH=8192
PLANE_AI_LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Runtime resources (docker compose) -------------------------------------
PLANE_AI_LLM_CPUS=4
PLANE_AI_LLM_MEMORY=6g
# llama.cpp CPU threads (match PLANE_AI_LLM_CPUS).
PLANE_AI_LLM_THREADS=4
# Ollama: how long the model stays loaded after the last request.
# PLANE_AI_OLLAMA_KEEP_ALIVE=24h
# Pin runtime images in production (latest tags change without notice):
# PLANE_AI_OLLAMA_IMAGE=ollama/ollama:<version>
# PLANE_AI_LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-<build>

# --- AI features --------------------------------------------------------------
# Shared secret Plane's backend sends as "Authorization: Bearer <token>". Required in
# production and by docker compose. Put the same value in Plane's apps/api/.env as
# PLANE_AI_TOKEN. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANE_AI_SERVICE_TOKEN=
# Effort for workspaces whose admin never chose one: high | medium | low.
# high = all threads, full context, a reviewer pass; low = 1-2 threads, small context, short answers.
PLANE_AI_DEFAULT_EFFORT=medium
# Generations at the same time. 1 is fastest on a small CPU box.
# PLANE_AI_LLM_MAX_CONCURRENCY=1
# Optional embedding model served by the runtime (e.g. nomic-embed-text on Ollama, pulled separately).
# Empty = lexical (BM25) search only, which needs no extra model.
# PLANE_AI_EMBED_MODEL=
# Identical requests reuse the answer for this many seconds (0 = off).
# PLANE_AI_CACHE_TTL_SECONDS=900
